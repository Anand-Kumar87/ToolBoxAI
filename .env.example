# ==============================================
# ToolVerse AI - Environment Configuration
# ==============================================

# Application URL
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="toolverse-secret-super-secure-key-32-chars-minimum"
NEXTAUTH_SECRET="toolverse-secret-super-secure-key-32-chars-minimum"

# Database (PostgreSQL - Neon / Supabase / Local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/toolverse_ai?schema=public"

# Google OAuth (Optional for local dev)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Gmail SMTP Service (Optional for transactional emails)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Razorpay Integration
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# Object Storage (Cloudflare R2 / AWS S3)
STORAGE_BUCKET="toolverse-files"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"

# AI Provider API Keys
AI_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Platform Administration
ADMIN_EMAIL="admin@toolverse.ai"
